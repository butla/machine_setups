[include]
	path = ~/.gitconfig_secret

[user]
	email = michal.bultrowicz@gmail.com
	name = Michal Bultrowicz
	signingkey = 505998161EA0D351
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[push]
	default = simple
[diff]
	tool = meld
	prompt = false
[difftool]
	prompt = false
[credential]
	helper = cache --timeout=10800
	credentialStore = secretservice
[merge]
	tool = meld
[status]
    showStash = true
[pull]
	ff = only
[log]
	date = iso
[protocol "keybase"]
	allow = always
[rebase]
	instructionFormat = "%ae # %s"

# Work identity and GPG key for BT projects. Keep this last, so it overrides [user].
[includeIf "gitdir:~/development/bt/"]
	path = ~/.gitconfig_bt
